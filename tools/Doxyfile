PROJECT_NAME           = "HiPaCs Core"
OUTPUT_DIRECTORY       = .generated/doxygen
INPUT                  = ../core
RECURSIVE              = YES
FILE_PATTERNS           = *.h *.cpp
EXTRACT_ALL            = YES
EXTRACT_STATIC         = YES
EXTRACT_PRIVATE        = YES
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
